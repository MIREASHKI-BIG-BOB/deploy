# Backend Main Service Environment Variables

# Server configuration
SERVER_ADDR=0.0.0.0
SERVER_PORT=8000

# ML Service connection
ML_ADDR=ml
ML_PORT=8000

# Sensor IPs (can override config.yaml)
# Format: SENSOR_IP_X where X is sensor number (1, 2, 3, ...)
SENSOR_IP_1=gen-1:8000
# SENSOR_IP_2=gen-2:8000
# SENSOR_IP_3=gen-3:8000
